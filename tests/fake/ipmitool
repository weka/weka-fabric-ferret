#!/opt/homebrew/bin/bash
# fake local ipmitool for fabric_ferret.sh's -t bmc lines (read out of band, tc_bmc.sh): only
# "-I lanplus -H <bmc> -U <user> (-E | -f <file>) sensor"; argv -> $FAKE_STATE/ipmi_calls.log; two degrees-C rows
# (Inlet 24, CPU1 61) and a fan line. FAKE_BMC_DOWN=<bmc>: no session (rc 1), as a dead BMC answers.
FAKE_STATE=${FAKE_STATE:?FAKE_STATE unset}
echo "ipmitool $*" >> "$FAKE_STATE/ipmi_calls.log"
h=; u=; e=; s=; i=; pf=
while (( $# )); do
    case $1 in -I) i=$2; shift 2 ;; -H) h=$2; shift 2 ;; -U) u=$2; shift 2 ;; -E) e=1; shift ;; -f) pf=$2; shift 2 ;; sensor) s=1; shift ;; *) echo "fake ipmitool: unexpected $1" >&2; exit 99 ;; esac
done
[[ $i == lanplus && -n $h && -n $u && ( $e == 1 || -n $pf ) && $s == 1 ]] || { echo "fake ipmitool: bad call" >&2; exit 98; }
if [[ -n $pf ]]; then IFS= read -r IPMI_PASSWORD < "$pf" || { echo "Unable to read password from file $pf" >&2; exit 1; }
else [[ -n ${IPMI_PASSWORD+x} ]] || { echo "Unable to read password from environment" >&2; exit 1; }; fi
[[ $h == "${FAKE_BMC_DOWN:-}" ]] && { echo "Error: Unable to establish IPMI v2 / RMCP+ session" >&2; exit 1; }
cat <<OUT
Inlet Temp       | 24.000     | degrees C  | ok    | na        | -7.000    | -2.000    | 38.000    | 42.000    | na
CPU1 Temp        | 61.000     | degrees C  | ok    | na        | 0.000     | 0.000     | 90.000    | 95.000    | na
Fan1             | 8400.000   | RPM        | ok    | na        | 600.000   | 840.000   | na        | na        | na
OUT
