#!/usr/bin/env bash
# build -- assemble the one-file fabric_ferret.sh and thermals_capture.sh from src/ (README, Source).
#   ./build          writes ./fabric_ferret.sh and ./thermals_capture.sh
#   ./build <dir>    writes both there instead
# Anything wrong stops it by name and leaves both targets alone; an assembly
# bash cannot parse is kept beside its target as <target>.rejected.
set -euo pipefail
dir=""   # never the caller's: an exported dir would redirect the build
if [ $# -gt 0 ]; then case $1 in /*) dir=$1 ;; *) dir=$PWD/$1 ;; esac; fi
cd "$(dirname "$0")"
dir=${dir:-$PWD}
[ -d "$dir" ] || { echo "build: $dir is not a directory" >&2; exit 1; }
names=(fabric_ferret.sh thermals_capture.sh)
tmps=()
trap 'rm -f ${tmps[@]+"${tmps[@]}"}' EXIT   # bash 3.2 (macOS) under set -u: an empty array is unbound
trap 'exit 1' HUP INT TERM
for name in "${names[@]}"; do
out=$dir/$name
[ ! -d "$out" ] || { echo "build: $out is a directory" >&2; exit 1; }
tmp=$(mktemp "$out.build.XXXXXX"); tmps+=("$tmp")
LC_ALL=C awk -v src=src -v top="$name" '
function fail(msg) { print "build: " msg > "/dev/stderr"; exit 1 }
# An apostrophe becomes close-quote, escaped quote, reopen: the text stays
# one bash single-quoted string.
function esc(s,    r, k) {
    while ((k = index(s, "\047")) > 0) { r = r substr(s, 1, k - 1) "\047\\\047\047"; s = substr(s, k + 1) }
    return r s
}
# The file text in place of a marker: its first line where the marker was,
# each later one under <ind> (an empty one stays empty), then <tail>. No
# line may end in a backslash: inside an unquoted heredoc bash would join
# it to the next.
function splice(file, head, tail, ind,    line, n, k, F, any) {
    while ((getline line < file) > 0) {
        if (line ~ /\\$/) fail(file " line " (n + 1) " ends in a backslash")
        F[++n] = esc(line); if (line != "") any = 1
    }
    close(file)
    if (!any) fail("cannot read " file " (missing, unreadable or empty)")
    printf "%s%s", head, F[1]
    for (k = 2; k <= n; k++) printf "\n%s", (F[k] == "" ? "" : ind F[k])
    print tail
}
# In a .sh file a "#@include <path>" line becomes that file under src/,
# recursively, and an awk program marker src/awk/<name>.awk; an .awk file
# comes in as it is. The banner goes in under the top file shebang.
function emit(file, top,    line, prev, n, sh, ms, ml, nm) {
    if (file in OPEN) fail("include cycle at " file)
    OPEN[file] = 1; sh = (file ~ /\.sh$/)
    while ((getline line < file) > 0) {
        n++
        if (!sh) print line
        else if (line ~ /^#@include [^ ]+$/) emit(src "/" substr(line, 11), 0)
        else if (match(line, /\047#@awk [A-Za-z0-9_.]+\047/) || (prev ~ /\047$/ && match(line, /^[ \t]*#@awk [A-Za-z0-9_.]+\047/))) {
            ms = RSTART; ml = RLENGTH
            if (substr(line, ms + ml) ~ /#@(include|awk)/) fail("one directive per line, in " file ": " line)
            nm = substr(line, ms, ml); sub(/^[ \t\047]*#@awk /, "", nm); sub(/\047$/, "", nm)
            match(line, /^[ \t]*/)
            splice(src "/awk/" nm ".awk", substr(line, 1, ms + index(substr(line, ms), "#@awk") - 2), substr(line, ms + ml - 1), substr(line, 1, RLENGTH))
        }
        else if (line ~ /#@(include|awk)/) fail("not a directive build knows, in " file ": " line)
        else print line
        prev = line
        if (top && n == 1)
            print "# Built by ./build from src/ (README, Source): edit src/, never this file."
    }
    close(file); delete OPEN[file]
    if (!n) fail("cannot read " file " (missing, unreadable or empty)")
}
BEGIN { emit(src "/" top, 1) }
' > "$tmp"
# A directive in a file build passed through as it is (an include not named
# .sh) would reach the output unexpanded.
if left=$(grep -n -E '#@(include|awk)' "$tmp"); then
    echo "build: unexpanded directive(s) in the $name assembly:" >&2; echo "$left" >&2; exit 1
fi
bash -n "$tmp" || {
    mv -f "$tmp" "$out.rejected"
    echo "build: the $name assembly does not parse (kept as $out.rejected); both targets left alone" >&2
    exit 1
}
done
# both assembled and parsed: only now is either target replaced
for i in "${!names[@]}"; do chmod 755 "${tmps[$i]}"; mv -f "${tmps[$i]}" "$dir/${names[$i]}"; done
# The repo's example host file is the built fabric_ferret.sh's own template (its usage text), so the two never
# drift: a default build writes it; a build to another path writes it there too.
ex=$(mktemp "$dir/hostlist.example.csv.XXXXXX"); tmps+=("$ex")
said=$(bash -c 'source "$1" && write_targets_template "$2"' _ "$dir/fabric_ferret.sh" "$ex" 2>&1) \
    || { echo "build: cannot write hostlist.example.csv (the bash on PATH must be 4.3+, as the tool needs): $said" >&2; exit 1; }
chmod 644 "$ex"   # mktemp's 0600 would survive the mv
mv -f "$ex" "$dir/hostlist.example.csv"
